# Copia como .env solo en el servidor. No subas los valores secretos a GitHub.
DOMAIN=tickets.tu-dominio.com
PORTAL_URL=https://tickets.tu-dominio.com
PORTAL_CLOUD=1
SETUP_TOKEN=
BUZON_ATENCION=adiv.puente@goexpertis.com
# Cambia a graph cuando TI haya autorizado Microsoft 365.
CORREO_MODO=desactivado
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
CORREO_INTERVALO=15

# Render Free + Supabase: configurar en el gestor de secretos, no en GitHub.
# El archivo .env no se carga automáticamente al ejecutar Python o los .bat.
# Para local SQLite dejar DATABASE_URL vacía y EXIGIR_DB_REMOTA=0.
DATABASE_URL=
EXIGIR_DB_REMOTA=0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=expedientes
